# Environment Variables

# Application
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/oh_sansi?schema=public

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRATION=7d

# Swagger
SWAGGER_TITLE=OH Sansi Backend API
SWAGGER_DESCRIPTION=The API documentation for OH Sansi Backend
SWAGGER_VERSION=1.0

# Logging
LOG_LEVEL=debug
LOG_DIR=logs
